DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
# Optional: direct (non-pooled) connection for Prisma migrations, e.g. db.prisma.io instead of pooled.db.prisma.io
DIRECT_DATABASE_URL=""

# openssl rand -base64 48
JWT_SECRET=""

# Seeded dashboard owner account (prisma/seed.ts)
ADMIN_NAME="Owner Potatoni"
ADMIN_EMAIL="admin@potatoni.id"
ADMIN_PASSWORD=""

# Optional register-only test account (prisma/seed.ts)
CASHIER_NAME="Cashier Potatoni"
CASHIER_EMAIL="cashier@potatoni.id"
CASHIER_PASSWORD=""

# Optional kitchen-screen test account (prisma/seed.ts)
KITCHEN_NAME="Kitchen Potatoni"
KITCHEN_EMAIL="kitchen@potatoni.id"
KITCHEN_PASSWORD=""

S3_ENDPOINT=https://t3.storage.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# Public URL of the deployed app (absolute links for share previews)
APP_URL=http://localhost:3000

# SMTP for team invites and voucher codes. Without SMTP_HOST, dev prints emails to the terminal.
# Gmail: smtp.gmail.com:587 + an App Password · Brevo: smtp-relay.brevo.com:587 · Resend: smtp.resend.com:465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Potatoni <no-reply@potatoni.id>"

# AI assistant service (apps/ai) behind Dashboard → Assistant
AI_SERVICE_URL=http://localhost:4000

# Firebase Cloud Messaging: order notifications for owner, cashier and kitchen.
# Console -> Project settings -> General (web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging -> Web configuration -> Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Service accounts -> Generate new private key (two fields out of the JSON)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
