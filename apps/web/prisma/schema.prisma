generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CASHIER
}

enum Category {
  FRIES
  CHICKEN
}

enum ModifierType {
  SEASONING // free, pick up to 2
  ADDON // paid extras
  UPGRADE // e.g. shoestring -> pom-pom
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  QRIS
  CASH
}

enum ActivitySource {
  POS
  DASHBOARD
  PUBLIC // customers on the voucher claim page
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum ClaimStatus {
  PENDING // waiting for the email code
  ISSUED // verified, voucher can be used
  REDEEMED // used on a paid order
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role            Role       @default(ADMIN)
  emailVerifiedAt DateTime?
  activities      Activity[]
  invitesSent     Invite[]   @relation("InvitesSent")
  assistantChats  AssistantChat[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Product {
  id         String           @id @default(cuid())
  name       String
  slug       String           @unique
  category   Category
  tagline    String?
  imageKey   String?
  isActive   Boolean          @default(true)
  sortOrder  Int              @default(0)
  variants   ProductVariant[]
  orderItems OrderItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String // S / M / L
  grams     Int
  price     Int // rupiah
  isPopular Boolean @default(false)
  sortOrder Int     @default(0)

  @@unique([productId, size])
}

model Modifier {
  id        String       @id @default(cuid())
  name      String
  type      ModifierType
  price     Int          @default(0)
  imageKey  String?
  appliesTo Category? // null = every product
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(QRIS)
  subtotal      Int
  total         Int
  cashReceived  Int?
  customerName  String?
  note          String?
  items         OrderItem[]
  locationId    String?
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  discount       Int           @default(0)
  voucherClaimId String?       @unique
  voucherClaim   VoucherClaim? @relation(fields: [voucherClaimId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
  cancelledAt   DateTime?

  @@index([createdAt])
  @@index([status])
  @@index([locationId, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshots, so editing the menu never rewrites sales history.
  productName  String
  variantSize  String
  variantGrams Int
  modifiers    Json // [{ id, name, type, price }]
  unitPrice    Int
  quantity     Int
  lineTotal    Int
}

model Purchase {
  id          String   @id @default(cuid())
  item        String
  quantity    Float
  unit        String
  total       Int
  supplier    String?
  note        String?
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  purchasedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([purchasedAt])
  @@index([locationId, purchasedAt])
}

model Activity {
  id         String         @id @default(cuid())
  action     String // e.g. order.created, purchase.deleted
  message    String
  source     ActivitySource
  entityType String?
  entityId   String?
  meta       Json?
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([createdAt])
}

// Where the stall is set up (e.g. "SMA Trinitas Bandung" for a month). Orders and stock
// purchases are tagged with the location scheduled for that day, so the owner can compare spots.
model Location {
  id        String     @id @default(cuid())
  name      String     @unique
  address   String?
  notes     String?
  startsOn  DateTime?  @db.Date
  endsOn    DateTime?  @db.Date // null = until the next move
  isActive  Boolean    @default(true)
  orders    Order[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([startsOn])
}

// Team invitations: the link in the email is the proof that the address works.
model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String?
  role        Role      @default(CASHIER)
  tokenHash   String    @unique // sha256 of the emailed token; the token itself is never stored
  invitedById String?
  invitedBy   User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  lastSentAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([email])
}

// People who claimed a voucher — the owner's marketing list (only blast those who consented).
model Customer {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  phone            String // +62… (WhatsApp)
  emailVerifiedAt  DateTime?
  marketingConsent Boolean        @default(false)
  consentAt        DateTime?
  claims           VoucherClaim[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([phone])
}

model VoucherCampaign {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique // public claim link /v/<slug>, printed as a QR code
  description   String?
  discountType  DiscountType
  discountValue Int // percent (1–100) or rupiah
  maxDiscount   Int? // cap for percent vouchers
  minSpend      Int            @default(0)
  claimStartsAt DateTime?      @db.Date
  claimEndsAt   DateTime?      @db.Date
  validDays     Int            @default(30) // how long a voucher works after it's issued
  quota         Int? // max vouchers issued
  isActive      Boolean        @default(true)
  claims        VoucherClaim[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model VoucherClaim {
  id            String          @id @default(cuid())
  campaignId    String
  campaign      VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone         String // one voucher per phone per campaign, too
  status        ClaimStatus     @default(PENDING)
  otpHash       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int             @default(0)
  otpSentCount  Int             @default(0)
  otpLastSentAt DateTime?
  code          String?         @unique // e.g. PTN-7KQ2XM, shown to the cashier
  issuedAt      DateTime?
  expiresAt     DateTime?
  redeemedAt    DateTime?
  order         Order? // set while a pending order holds the voucher, and after redemption
  createdAt     DateTime        @default(now())

  @@unique([campaignId, customerId])
  @@unique([campaignId, phone])
  @@index([status])
}

enum AssistantRole {
  USER
  ASSISTANT
}

// Dashboard → Assistant conversations, one history per team member.
model AssistantChat {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // the first question, shortened
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id        String        @id @default(cuid())
  chatId    String
  chat      AssistantChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      AssistantRole
  content   String
  images    String[]      @default([]) // S3 keys of attached photos/screenshots (assistant/…)
  tools     String[]      @default([]) // what the assistant looked at (sales, locations, web search…)
  actions   Json? // proposed purchases/location with their status: [{ type, …, status }]
  replies   String[]      @default([]) // suggested follow-up questions
  createdAt DateTime      @default(now())

  @@index([chatId, createdAt])
}
