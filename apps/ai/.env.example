# DATABASE_URL and JWT_SECRET are read from ../web/.env when running locally;
# set them here too (or in the host's env) when the service runs on its own.
# DATABASE_URL=""
# JWT_SECRET=""

# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=""
# Fast and cheap by default; claude-sonnet-5 or claude-opus-5 for deeper answers.
ANTHROPIC_MODEL=claude-haiku-4-5

PORT=4000
